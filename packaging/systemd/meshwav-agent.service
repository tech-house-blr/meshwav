[Unit]
Description=Meshwav audio agent (streams this PC's audio to paired receivers)
Documentation=https://github.com/tech-house-blr/meshwav
# User units cannot wait for the system tailscaled. If the tailnet is not up yet the agent exits
# and Restart= tries again, so no ordering is needed. These only order it after the sound server
# when that runs as a user service.
After=pipewire-pulse.service pulseaudio.service

[Service]
Type=simple
ExecStart=/usr/bin/meshwav send
# SIGTERM makes the agent hand the PC's audio output back before it exits.
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

# Sandbox. The agent needs the network, the sound server socket and its own config folder, nothing
# else. Home is read-only except ~/.config/meshwav; the "+" step creates that folder before the
# sandbox is set up, so a first start (nothing paired yet) still works.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.config/meshwav
ExecStartPre=+/bin/mkdir -p %h/.config/meshwav
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=default.target
